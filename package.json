{
  "name": "nora-tunnel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "android:patch": "bash scripts/patch-android.sh",
    "android:debug": "cd android && ./gradlew assembleDebug --no-daemon",
    "android:release": "cd android && ./gradlew assembleRelease --no-daemon",
    "apk:setup": "npm run build && npx cap add android && npx cap sync android && bash scripts/patch-android.sh",
    "apk:build": "npm run build && npx cap sync android && npx cap copy android && bash scripts/patch-android.sh && cd android && ./gradlew assembleDebug --no-daemon"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.51.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
